# Copy this file to backend/.env and replace the placeholder locally.
OPENAI_API_KEY=replace-with-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
RETRIEVAL_STRATEGY=vector
HYBRID_CANDIDATE_TOP_K=20
RRF_CONSTANT=60
RERANKING_ENABLED=false
RERANK_CANDIDATE_TOP_K=20
RERANK_TOP_K=5
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60.0
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.0
# Optional: set these to get an actual cost estimate in logs. Leave unset
# (commented out) to report token usage without fabricating a cost (see
# docs/observability.md).
# LLM_PROMPT_PRICE_PER_1K=0.01
# LLM_COMPLETION_PRICE_PER_1K=0.03
POSTGRES_DB=ai_support
POSTGRES_TEST_DB=ai_support_test
POSTGRES_USER=ai_support
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://ai_support:replace-with-a-local-password@localhost:5432/ai_support
TEST_DATABASE_URL=postgresql+psycopg://ai_support:replace-with-a-local-password@localhost:5432/ai_support_test
