# Copy this file to backend/.env and replace the placeholder locally.
OPENAI_API_KEY=replace-with-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
RETRIEVAL_STRATEGY=vector
HYBRID_CANDIDATE_TOP_K=20
RRF_CONSTANT=60
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.0
POSTGRES_DB=ai_support
POSTGRES_TEST_DB=ai_support_test
POSTGRES_USER=ai_support
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ai_support:replace-with-a-local-password@localhost:5432/ai_support
TEST_DATABASE_URL=postgresql+psycopg://ai_support:replace-with-a-local-password@localhost:5432/ai_support_test
